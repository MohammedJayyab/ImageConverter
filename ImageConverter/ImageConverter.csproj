<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>ImageConverter.ico</ApplicationIcon>
    <Version>1.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.13.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="HelpHowToUse.rtf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\images\splash_screen.png">
      <Link>images\splash_screen.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ImageConverter.ico" />
  </ItemGroup>

  <!-- After self-contained publish, remove duplicate build output in win-x64; keep only the publish folder. -->
  <Target Name="CleanupWinX64AfterPublish" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true' AND '$(RuntimeIdentifier)' == 'win-x64'">
    <PropertyGroup>
      <_WinX64Root>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\win-x64</_WinX64Root>
      <_PublishSubdir>publish</_PublishSubdir>
    </PropertyGroup>
    <Message Importance="high" Text="Cleaning $(_WinX64Root) (keeping $(_PublishSubdir)\ only)..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\cleanup-after-publish.ps1&quot; -RidRoot &quot;$(_WinX64Root)&quot; -KeepFolder &quot;$(_PublishSubdir)&quot;" />
  </Target>

</Project>